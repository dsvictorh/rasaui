{
   "tabWidth": 3,
   "useTabs": false,
   "bracketSameLine": true,
   "printWidth": 120,
   "singleQuote": true,
   "trailingComma": "none",
   "overrides": [
      {
         "files": "*.html",
         "options": {
            "parser": "angular",
            "printWidth": 90
         }
      }
   ]
}
